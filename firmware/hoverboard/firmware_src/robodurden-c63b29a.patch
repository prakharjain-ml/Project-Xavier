diff --git a/HoverBoardGigaDevice/platformio.ini b/HoverBoardGigaDevice/platformio.ini
index fd707ae..d9ddee8 100644
--- a/HoverBoardGigaDevice/platformio.ini
+++ b/HoverBoardGigaDevice/platformio.ini
@@ -64,3 +64,112 @@ board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
 extra_scripts = add_RTT_task.py
     add_RTT_console.py
 
+
+
+; ---- added for HackPrinceton: GD32E235 board (no external crystal) ----
+; autodetect over RTT, internal clock (IRC8M/2 -> PLL 72 MHz)
+[env:e230_autodetect_rtt]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D REMOTE_AUTODETECT
+    -D RTT_REMOTE
+    -D AD_SAFE_PWM=-80
+    -D FLASH_SIZE_OVERRIDE=65536
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
+
+; motor test build for our board: layout 2-3-9, SINGLE, REMOTE_DUMMY zigzag (gentle), internal clock
+[env:e235_test]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D LAYOUT=9
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D FLASH_SIZE_OVERRIDE=65536
+    -D BAT_CELLS=7
+    -D DISABLE_BUTTON
+    -D DISABLE_CHARGESTATE
+    -D HP_DUMMY_MAX=120
+    ${sysenv.HP_FLAGS}
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
+
+; ---- real firmware for our board (layout 2-3-9) ----
+; MASTER: listens to ESP32 on USART0 PB6/PB7 (19200 baud), talks to slave over USART1 PA2/PA3 (original cable)
+[env:e235_master]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D LAYOUT=9
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D FLASH_SIZE_OVERRIDE=65536
+    -D BAT_CELLS=7
+    -D DISABLE_BUTTON
+    -D DISABLE_CHARGESTATE
+    -D MASTER
+    -D REMOTE_UART
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
+
+[env:e235_slave]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D LAYOUT=9
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D FLASH_SIZE_OVERRIDE=65536
+    -D BAT_CELLS=7
+    -D DISABLE_BUTTON
+    -D DISABLE_CHARGESTATE
+    -D SLAVE
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
+
+; SINGLE board + ESP32 on PB6/PB7 - to test the master board alone with the ESP32 before the slave is flashed
+[env:e235_single_uart]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D LAYOUT=9
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D FLASH_SIZE_OVERRIDE=65536
+    -D BAT_CELLS=7
+    -D DISABLE_BUTTON
+    -D DISABLE_CHARGESTATE
+    -D REMOTE_UART
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
+
+; SINGLE board driven by the ESP32 through the 4-pin master-slave plug (USART1 = PA2/PA3).
+; Used on BOTH boards (left and right), each with its own ESP32 UART. No soldering needed:
+; the TX/RX pads of USART0 are not connected on the YK187 board (R10/R11 not fitted).
+[env:e235_single_usart1]
+board = genericGD32E230C8
+framework = spl
+build_flags = 
+    -D GD32E230
+    -D TARGET=3
+    -D LAYOUT=9
+    -D __SYSTEM_CLOCK_72M_PLL_IRC8M_DIV2=72000000UL
+    -D __PIO_DONT_SET_CLOCK_SOURCE__
+    -D FLASH_SIZE_OVERRIDE=65536
+    -D BAT_CELLS=7
+    -D DISABLE_BUTTON
+    -D DISABLE_CHARGESTATE
+    -D REMOTE_UART
+    -D REMOTE_USART=1
+    -D NO_INACTIVITY_TIMEOUT
+    -D KEEP_SELF_HOLD
+board_build.ldscript = lib/spl/gd32f1x0/gd32f1x0.ld
